# Address the Orca client uses to reach this server. Defaults to HOST_BIND;
# set this only when the client reaches the server via a different address
# (e.g. a LAN hostname or an overlay address — see README
# "Access from another network").
# ORCA_PAIRING_ADDRESS=orca.lan

# Host interface used as bind address for all published ports (the runtime, SSH
# and Syncthing). Restricting this to 127.0.0.1 requires an SSH tunnel for
# external access (including the Syncthing GUI). Use your LAN IP (e.g.
# 192.168.0.10) when the Orca client reaches the ports directly over the LAN.
HOST_BIND=127.0.0.1
SSH_HOST_PORT=2222

# Engine name of the volume mounted at /home/agent. Point it at an existing
# volume to keep that volume's data; the default is used when unset.
# VOLUME_NAME=agentic-container-home

# Per-service resource caps. Memory needs a unit — a bare number is bytes —
# and the swap limit tracks it, so swap is disabled: an over-capped
# container is OOM-killed rather than consuming host swap. CPUs accept
# fractions, e.g. 0.5.
# RUNTIME_MEM_LIMIT=8gb
# RUNTIME_CPUS=2
# SYNCTHING_MEM_LIMIT=512m
# SYNCTHING_CPUS=0.5

# Optional Orca flags.
ORCA_JSON=0
ORCA_MOBILE_PAIRING=0
# Set to 1 if Chromium reports sandbox errors.
ORCA_NO_SANDBOX=0

# Syncthing GUI credentials. Set both to require authentication; applied at
# every container start (overriding anything set in the GUI).
SYNCTHING_USER=
SYNCTHING_PASSWORD=

# Orca release installed when the image is built. Unset builds the newest
# release; pin a version to reproduce a build (see README "Runtime: Orca").
# ORCA_VERSION=1.4.215
